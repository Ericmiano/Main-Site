// Downloads host: serves the "aak-documents" R2 bucket.
// Deploy from this folder: npx wrangler deploy --config wrangler.jsonc
// The originals are kept in the repo's documents/ folder (not public/, so they
// stay out of the cPanel upload). To add a file, put it there, then:
//   npx wrangler r2 object put "aak-documents/documents/<file>" --file documents/<file> --content-type application/pdf --remote
// (audio/mpeg for .mp3) and link it with fileUrl("/documents/<file>").
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aak-files",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "aak-documents" }]
}
